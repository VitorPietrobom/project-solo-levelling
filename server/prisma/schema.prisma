// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Recurrence {
  daily
  weekly
}

enum QuestPriority {
  low
  medium
  high
}

enum MeasurementType {
  chest
  waist
  hips
  arms
  thighs
}

enum MuscleGroup {
  chest
  back
  shoulders
  biceps
  triceps
  quads
  hamstrings
  glutes
  calves
  abs
  forearms
}

enum DayOfWeek {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum DocumentFormat {
  pdf
  markdown
}

// Node types in the knowledge graph. The first three replace the old
// Note / JournalEntry / LessonLearned models; the rest are new.
enum KnowledgeKind {
  note
  journal
  lesson
  idea
  question
  source
  person
  concept
}

enum EdgeKind {
  relates
  supports
  contradicts
  derived_from
  example_of
}

enum BookStatus {
  want_to_read
  reading
  finished
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id              String   @id
  email           String   @unique
  totalXP         Int      @default(0)
  calorieGoal     Int      @default(2000)
  // Nutrition engine settings
  nutritionGoal   String   @default("maintain") // cut | maintain | bulk | recomp
  nutritionAdjust String   @default("steady") // steady | reactive
  calorieDelta    Int      @default(0) // signed daily kcal adjustment (cut = negative)
  proteinPerKg    Float    @default(1.8)
  // Learning
  readingGoal     Int      @default(12) // books per year
  // Optional display name for the hero card — falls back to the email's
  // local part when unset, so the UI never has to say generic "Hunter".
  hunterName      String?
  createdAt       DateTime @default(now())

  quests            Quest[]
  tasks             Task[]
  skills            Skill[]
  dailyActivity     DailyActivity[]
  weightEntries     WeightEntry[]
  measurements      Measurement[]
  gymSessions       GymSession[]
  trainingPrograms  TrainingProgram[]
  foodEntries       FoodEntry[]
  recipes           Recipe[]
  mealPrepPlans     MealPrepPlan[]
  documents         Document[]
  books             Book[]
  journalEntries    JournalEntry[]
  lessonsLearned    LessonLearned[]
  notes             Note[]
  knowledgeNodes    KnowledgeNode[]
  knowledgeEdges    KnowledgeEdge[]
  whoopConnection   WhoopConnection?
  whoopDailies      WhoopDaily[]
  nutritionXpClaims NutritionXpClaim[]
}

model NutritionXpClaim {
  id        String   @id @default(uuid())
  userId    String
  date      String // YYYY-MM-DD the XP was claimed for
  xp        Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model WhoopDaily {
  id        String   @id @default(uuid())
  userId    String
  date      String // YYYY-MM-DD (the cycle's calendar day)
  calories  Int // total energy burned that day (kcal, from WHOOP kilojoules)
  strain    Float?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model WhoopConnection {
  id           String    @id @default(uuid())
  userId       String    @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String?
  whoopUserId  String?
  latest       Json?
  syncedAt     DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A Quest is either a one-time goal (recurrence null — completion is
// permanent, optionally broken into steps) or a recurring habit (recurrence
// set — completion resets every day/week, mirrors the old Task model, which
// this absorbed). The two behave differently but share one form, one set of
// endpoints, and one skill link, instead of being two separate systems.
model Quest {
  id              String        @id @default(uuid())
  userId          String
  title           String
  // Optional — a recurring habit usually doesn't need one.
  description     String?
  xpReward        Int
  priority        QuestPriority @default(medium)
  dueDate         DateTime?     @db.Date
  linkedSkillId   String?
  recurrence      Recurrence?
  // One-time quests: true once permanently done.
  completed       Boolean       @default(false)
  // Recurring quests: when the current period was last completed; the
  // "completed for today/this week" state is derived from this, the same
  // way the old Task model worked.
  lastCompletedAt DateTime?
  // Set only on rows created by the one-time "import my tasks" migration,
  // so re-running it is idempotent and never double-imports.
  legacyTaskId    String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps QuestStep[]
}

// One row per day the user did anything XP-worthy. The only purpose is a
// cheap, honest streak count — no per-action history, just "was this day
// active". awardXP() upserts today's row every time it runs.
model DailyActivity {
  id     String @id @default(uuid())
  userId String
  date   String // YYYY-MM-DD, UTC

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model QuestStep {
  id          String  @id @default(uuid())
  questId     String
  description String
  sortOrder   Int
  completed   Boolean @default(false)

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
}

model Task {
  id              String     @id @default(uuid())
  userId          String
  title           String
  recurrence      Recurrence
  xpReward        Int
  completedToday  Boolean    @default(false)
  lastCompletedAt DateTime?
  linkedSkillId   String?
  createdAt       DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id        String   @id @default(uuid())
  userId    String
  name      String
  totalXP   Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeightEntry {
  id     String   @id @default(uuid())
  userId String
  weight Float
  date   DateTime @db.Date
  // "manual" (a weigh-in the user typed) or "whoop" (auto-logged from a sync).
  // A WHOOP sync may refresh its own row for the day but must never overwrite
  // a manual entry.
  source String   @default("manual")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Measurement {
  id     String          @id @default(uuid())
  userId String
  type   MeasurementType
  value  Float
  date   DateTime        @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GymSession {
  id     String   @id @default(uuid())
  userId String
  date   DateTime @db.Date
  notes  String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises Exercise[]
}

model Exercise {
  id        String @id @default(uuid())
  sessionId String
  name      String
  sets      Int
  reps      Int
  weight    Float

  session      GymSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  muscleGroups ExerciseMuscleGroup[]
}

model ExerciseMuscleGroup {
  exerciseId  String
  muscleGroup MuscleGroup

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroup])
}

model TrainingProgram {
  id        String   @id @default(uuid())
  userId    String
  name      String
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  days ProgramDay[]
}

model ProgramDay {
  id        String    @id @default(uuid())
  programId String
  dayOfWeek DayOfWeek

  program   TrainingProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises ProgramExercise[]
}

model ProgramExercise {
  id           String @id @default(uuid())
  programDayId String
  name         String
  sets         Int
  reps         Int
  targetWeight Float
  sortOrder    Int

  programDay ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
}

model FoodEntry {
  id       String   @id @default(uuid())
  userId   String
  foodName String
  calories Int
  protein  Float    @default(0)
  carbs    Float    @default(0)
  fat      Float    @default(0)
  mealType MealType
  date     DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipe {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  steps              String
  caloriesPerServing Int
  protein            Int      @default(0)
  carbs              Int      @default(0)
  fat                Int      @default(0)
  servings           Int      @default(1)
  createdAt          DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients     Ingredient[]
  mealPrepEntries MealPrepEntry[]
}

model Ingredient {
  id       String @id @default(uuid())
  recipeId String
  name     String
  quantity String
  unit     String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model MealPrepPlan {
  id            String   @id @default(uuid())
  userId        String
  weekStartDate DateTime @db.Date

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries MealPrepEntry[]
}

model MealPrepEntry {
  id        String    @id @default(uuid())
  planId    String
  dayOfWeek DayOfWeek
  mealType  MealType
  recipeId  String

  plan   MealPrepPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipe Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([planId, dayOfWeek, mealType])
}

model Document {
  id         String         @id @default(uuid())
  userId     String
  title      String
  category   String
  format     DocumentFormat
  filePath   String
  content    String?
  uploadedAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Book {
  id            String     @id @default(uuid())
  userId        String
  title         String
  author        String
  status        BookStatus @default(want_to_read)
  totalPages    Int
  currentPage   Int        @default(0)
  notes         String?
  rating        Int?
  coverUrl      String?
  linkedSkillId String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id            String   @id @default(uuid())
  userId        String
  content       String
  tags          String[] @default([])
  linkedSkillId String?
  date          DateTime @db.Date
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LessonLearned {
  id            String   @id @default(uuid())
  userId        String
  content       String
  tags          String[] @default([])
  linkedSkillId String?
  date          DateTime @db.Date
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Knowledge graph ─────────────────────────────────────────────────────────

model KnowledgeNode {
  id            String        @id @default(uuid())
  userId        String
  kind          KnowledgeKind @default(note)
  title         String
  content       String        @default("")
  tags          String[]      @default([])
  linkedSkillId String?
  bookId        String?
  // Set when the row was backfilled from the legacy note/journal/lesson tables,
  // so the import stays idempotent.
  legacyId      String?       @unique
  date          DateTime?     @db.Date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoing KnowledgeEdge[] @relation("edgeFrom")
  incoming KnowledgeEdge[] @relation("edgeTo")

  @@index([userId])
}

model KnowledgeEdge {
  id        String   @id @default(uuid())
  userId    String
  fromId    String
  toId      String
  kind      EdgeKind @default(relates)
  // Edges created by parsing [[wiki-links]] out of node content are managed
  // automatically and rebuilt on every save; manual edges are never touched.
  auto      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  from KnowledgeNode @relation("edgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   KnowledgeNode @relation("edgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@index([userId])
}
